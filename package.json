{
  "name": "omd-home",
  "version": "0.1.0",
  "private": true,
  "description": "Open a local-first dashboard, calendar, Inbox, and omnibox for OMD.",
  "type": "module",
  "main": "main.js",
  "license": "PolyForm-Shield-1.0.0",
  "scripts": {
    "build": "node esbuild.mjs production",
    "dev": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json package-lock.json",
    "build:eventkit": "bash scripts/build-eventkit.sh",
    "install:test-vault": "node scripts/install-test-vault.mjs"
  },
  "dependencies": {
    "fullcalendar": "^7.0.1",
    "temporal-polyfill": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.46.1"
  }
}
